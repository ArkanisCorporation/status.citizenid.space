{
  "Kener": {
    "Origin": "https://status.citizenid.dev"
  },
  "Kubernetes": {
    "Namespace": "citizenid-status-staging",
    "Secrets": {
      "SecretStore": {
        "Name": "onepassword-connect",
        "Kind": "ClusterSecretStore"
      },
      "ParameterSources": {
        "kener-secret-key": {
          "Kind": "PasswordGenerator",
          "Password": {
            "Length": 64,
            "Digits": 8,
            "Symbols": 8,
            "Rotation": "CreatedOnce"
          }
        },
        "redis-password": {
          "Kind": "PasswordGenerator",
          "Password": {
            "Length": 32,
            "Digits": 4,
            "Symbols": 4,
            "Rotation": "CreatedOnce"
          }
        }
      }
    },
    "Ingress": {
      "CertClusterIssuerName": "letsencrypt-production",
      "Resources": {
        "kener": {
          "kener-ingress": {
            "Host": "status.citizenid.dev",
            "TlsSecretName": "kener-tls"
          }
        }
      }
    },
    "CloudNativePostgres": {
      "Resources": {
        "database": {
          "ClusterName": "postgres-production",
          "Namespace": "postgres-production",
          "DatabaseName": "citizenid-staging-status",
          "CredentialsSecret": {
            "SourceSecretName": "citizenid-staging-status-credentials",
            "TargetSecretName": "kener-database",
            "ConnectionStringKey": "DATABASE_URL",
            "SecretStore": {
              "Name": "postgres-production-credentials",
              "Kind": "ClusterSecretStore"
            }
          }
        }
      }
    }
  },
  "Parameters": {
    "smtp-username": "op://fsiiw64phrzw5pkkhfqkxibcfu/3xuz33wvb5zxfhrvg7uthjcqme/username",
    "smtp-password": "op://fsiiw64phrzw5pkkhfqkxibcfu/3xuz33wvb5zxfhrvg7uthjcqme/password"
  }
}
