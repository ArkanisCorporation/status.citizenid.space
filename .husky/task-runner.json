{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
       {
           "name": "dotnet-format-check",
           "group": "pre-commit",
           "command": "dotnet",
           "args": [ "format", "Arkanis.Infra.Deployment.CitizenId.Status.slnx", "--verify-no-changes", "--verbosity", "diagnostic", "--no-restore" ]
       },
       {
           "name": "dotnet-format",
           "command": "dotnet",
           "args": [ "format", "Arkanis.Infra.Deployment.CitizenId.Status.slnx", "--verbosity", "diagnostic", "--no-restore" ]
       },
       {
           "name": "dotnet-aspire-agent-init",
           "group": "init",
           "command": "dotnet",
           "args": [ "aspire", "agent", "init", "--skill-locations", "standard,claudecode", "--skills", "all", "--non-interactive" ]
       }
   ]
}
