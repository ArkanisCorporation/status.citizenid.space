{
  "Kener": {
    "Origin": "https://status.example.test"
  },
  "Kubernetes": {
    "Namespace": "citizenid-status-publish-test",
    "Secrets": {
      "SecretStore": {
        "Name": "fixture-onepassword",
        "Kind": "ClusterSecretStore"
      }
    },
    "Ingress": {
      "CertClusterIssuerName": "fixture-issuer",
      "Resources": {
        "web": {
          "web-ingress": {
            "TlsSecretName": "web-tls"
          }
        }
      }
    },
    "CloudNativePostgres": {
      "Resources": {
        "database": {
          "ClusterName": "fixture-cluster",
          "Namespace": "fixture-postgres",
          "DatabaseName": "citizenid-publish-test-status",
          "Owner": "citizenid-status-publish-test",
          "CredentialsSecret": {
            "RefreshInterval": "1m",
            "SourceSecretName": "citizenid-status-publish-test-credentials",
            "TargetSecretName": "web-database",
            "ConnectionStringKey": "DATABASE_URL",
            "SecretStore": {
              "Name": "fixture-postgres-credentials",
              "Kind": "ClusterSecretStore"
            }
          }
        }
      }
    }
  },
  "Parameters": {
    "smtp-username": "op://fixture/publish-test/smtp-username",
    "smtp-password": "op://fixture/publish-test/smtp-password"
  }
}
